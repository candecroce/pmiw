const duracionPantalla = 6000;
const imagenes = [];
let tiempoInicio = 0;
let indiceAnterior = -1;
let sonidoActivo = false;
let contextoAudio = null;

const pantallas = [
  { archivo: "data/imagen01.jpeg", titulo: "LONDRES, 1890", texto: "Bajo la niebla y las luces de gas, Londres guarda un secreto." },
  { archivo: "data/imagen02.jpeg", titulo: "LA CARTA MISTERIOSA", texto: "El doctor Jekyll encuentra una carta inquietante. El nombre de Hyde aparece en ella." },
  { archivo: "data/imagen03.jpeg", titulo: "LA PUERTA CERRADA", texto: "En una calle oscura, una vieja puerta parece esconder algo terrible." },
  { archivo: "data/imagen04.jpeg", titulo: "LA APARICIÓN DE HYDE", texto: "Una figura cruza la niebla. Su presencia basta para helar la noche." },
  { archivo: "data/imagen05.jpeg", titulo: "UNA INVESTIGACIÓN COMIENZA", texto: "Jekyll revisa cada pista y descubre que Hyde está más cerca de lo que imaginaba." },
  { archivo: "data/imagen06.jpeg", titulo: "LA PERSECUCIÓN", texto: "Un misterioso hombre se aleja por las calles vacías de Londres." },
  { archivo: "data/imagen07.jpeg", titulo: "EL DOCTOR JEKYLL", texto: "Durante el día, el doctor intenta conservar la calma y continuar con su vida." },
  { archivo: "data/imagen08.jpeg", titulo: "EL LABORATORIO", texto: "En su laboratorio, Jekyll prepara un experimento que podría cambiarlo todo." },
  { archivo: "data/imagen09.jpeg", titulo: "EL EXPERIMENTO", texto: "Convencido de que puede separar sus impulsos, Jekyll toma la pócima." },
  { archivo: "data/imagen10.jpeg", titulo: "LA HUIDA", texto: "Hyde huye por las calles mientras la niebla lo oculta de sus perseguidores." },
  { archivo: "data/imagen11.jpeg", titulo: "EL DOMINIO DE HYDE", texto: "La criatura regresa. Cada vez parece más fuerte y difícil de controlar." },
  { archivo: "data/imagen12.jpeg", titulo: "DOS SOMBRAS", texto: "Detrás del vidrio, Jekyll lucha por resistir a la otra presencia." },
  { archivo: "data/imagen13.jpeg", titulo: "FRENTE AL ESPEJO", texto: "Jekyll mira su reflejo, pero ya no está seguro de quién lo observa." },
  { archivo: "data/imagen14.jpeg", titulo: "LA TRANSFORMACIÓN", texto: "La transformación se completa. Hyde ha tomado el control." },
  { archivo: "data/imagen15.jpeg", titulo: "EL AMANECER", texto: "Amanece sobre Londres. El secreto del doctor queda entre sus calles." }
];

function preload() {
  for (let i = 0; i < pantallas.length; i++) {
    imagenes[i] = loadImage(
      pantallas[i].archivo,
      () => {},
      (error) => console.error("No se pudo cargar " + pantallas[i].archivo, error)
    );
  }
}

function setup() {
  createCanvas(800, 450);
  textFont("Georgia");v
  tiempoInicio = millis();
}

function draw() {
  background(0);

  const transcurrido = millis() - tiempoInicio;
  const indice = min(floor(transcurrido / duracionPantalla), pantallas.length - 1);

  if (indice !== indiceAnterior) {
    if (sonidoActivo) reproducirTono(440 + (indice % 5) * 55);
    indiceAnterior = indice;
  }

  dibujarImagen(imagenes[indice]);
  mostrarTexto(pantallas[indice].titulo, pantallas[indice].texto, indice + 1);
  dibujarControles();
}

function dibujarImagen(img) {
  if (!img || img.width === 0 || img.height === 0) return;

  const escala = max(width / img.width, height / img.height);
  const anchoRecorte = width / escala;
  const altoRecorte = height / escala;
  const xRecorte = (img.width - anchoRecorte) / 2;
  const yRecorte = (img.height - altoRecorte) / 2;

  image(img, 0, 0, width, height, xRecorte, yRecorte, anchoRecorte, altoRecorte);
}

function mostrarTexto(titulo, texto, numero) {
  noStroke();
  fill(0, 0, 0, 190);
  rect(0, height - 105, width, 105);

  fill(230, 190, 115);
  textAlign(RIGHT, TOP);
  textSize(14);
  text(numero + " / 15", width - 24, height - 90);

  fill(255);
  textAlign(LEFT, TOP);
  textSize(20);
  text(titulo, 28, height - 88, width - 100, 28);

  textSize(16);
  text(texto, 28, height - 55, width - 56, 45);
}

function dibujarControles() {
  dibujarBoton(width - 188, 16, 92, 34, sonidoActivo ? "SONIDO: ON" : "SONIDO: OFF");
  dibujarBoton(width - 88, 16, 72, 34, "REINICIAR");
}

function dibujarBoton(x, y, ancho, alto, etiqueta) {
  noStroke();
  fill(0, 0, 0, 175);
  rect(x, y, ancho, alto, 7);
  fill(255, 238, 205);
  textAlign(CENTER, CENTER);
  textSize(11);
  text(etiqueta, x + ancho / 2, y + alto / 2);
}

function mousePressed() {
  if (mouseX >= width - 88 && mouseX <= width - 16 && mouseY >= 16 && mouseY <= 50) {
    tiempoInicio = millis();
    indiceAnterior = -1;
    return false;
  }

  if (mouseX >= width - 188 && mouseX <= width - 96 && mouseY >= 16 && mouseY <= 50) {
    sonidoActivo = !sonidoActivo;
    if (sonidoActivo) {
      if (!contextoAudio) {
        const AudioContextClase = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClase) contextoAudio = new AudioContextClase();
      }
      if (contextoAudio && contextoAudio.state === "suspended") contextoAudio.resume();
      reproducirTono(523.25);
    }
    return false;
  }
}

function reproducirTono(frecuencia) {
  if (!sonidoActivo || !contextoAudio) return;

  const ahora = contextoAudio.currentTime;
  const oscilador = contextoAudio.createOscillator();
  const volumen = contextoAudio.createGain();

  oscilador.type = "sine";
  oscilador.frequency.setValueAtTime(frecuencia, ahora);
  volumen.gain.setValueAtTime(0.0001, ahora);
  volumen.gain.exponentialRampToValueAtTime(0.06, ahora + 0.04);
  volumen.gain.exponentialRampToValueAtTime(0.0001, ahora + 0.7);

  oscilador.connect(volumen);
  volumen.connect(contextoAudio.destination);
  oscilador.start(ahora);
  oscilador.stop(ahora + 0.72);
}
